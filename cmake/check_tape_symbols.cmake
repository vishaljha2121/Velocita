if(NOT TARGET_FILE OR NOT EXISTS "${TARGET_FILE}")
    message(FATAL_ERROR "TARGET_FILE not found: ${TARGET_FILE}")
endif()
if(UNDEFINED_ONLY)
    set(nm_args -u)
endif()
execute_process(COMMAND nm ${nm_args} "${TARGET_FILE}"
    RESULT_VARIABLE nm_result OUTPUT_VARIABLE listed ERROR_VARIABLE nm_error)
if(NOT nm_result EQUAL 0)
    message(FATAL_ERROR "nm failed on ${TARGET_FILE}: ${nm_error}")
endif()
string(LENGTH "${listed}" listed_length)
if(listed_length LESS 64)
    message(FATAL_ERROR "nm listed almost nothing for ${TARGET_FILE}; the check would be vacuous")
endif()
string(REPLACE "\n" ";" lines "${listed}")
set(found "")
foreach(line IN LISTS lines)
    string(REGEX REPLACE "^.* " "" symbol "${line}")
    string(REGEX REPLACE "^_" "" bare "${symbol}")
    if(bare MATCHES "${FORBIDDEN}")
        list(APPEND found "${symbol}")
    endif()
endforeach()
if(found)
    list(LENGTH found count)
    list(SUBLIST found 0 5 sample)
    message(FATAL_ERROR "${CHECK}: ${count} forbidden symbols in ${TARGET_FILE}, for example ${sample}")
endif()
message(STATUS "${CHECK}: no forbidden symbols in ${TARGET_FILE}")
