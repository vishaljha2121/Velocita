[Unit]
Description=Velocita model - daily research report
After=velocita-model-collector.service

[Service]
Type=oneshot
User=velocita
Group=velocita
WorkingDirectory=/opt/velocita-model
Environment=PYTHONPATH=/opt/velocita-model/src
ExecStart=/usr/bin/python3 -m velocita_model.cli report /opt/velocita-model/config/research.toml
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/velocita-model
SyslogIdentifier=velocita-model-report
