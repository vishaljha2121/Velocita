[Unit]
Description=Velocita model - passive market-data research collector
Documentation=file:/opt/velocita-model/docs/V2_MODEL_AND_MARKET_DATA_EDGE_DESIGN.md
After=network-online.target chronyd.service
Wants=network-online.target

[Service]
Type=simple
User=velocita
Group=velocita
WorkingDirectory=/opt/velocita-model
Environment=PYTHONPATH=/opt/velocita-model/src
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/usr/bin/python3 -m velocita_model.cli verify
ExecStart=/usr/bin/python3 -m velocita_model.cli collect /opt/velocita-model/config/research.toml

Restart=on-failure
RestartSec=15s
TimeoutStopSec=60s
KillSignal=SIGTERM

CPUQuota=40%
MemoryMax=512M
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/velocita-model

StandardOutput=journal
StandardError=journal
SyslogIdentifier=velocita-model

[Install]
WantedBy=multi-user.target
