#!/usr/bin/env python3
"""velocita-secrets: the owner's Mac is the source of truth for node secrets.

Secrets live in the macOS Keychain (service "velocita", one account per
secret, stored as hex). They are pushed over SSH into a private tmpfs
directory on each host and never written to NUC/Pi disk. A secret value never
appears in a command line, an environment variable or this tool's output.

  velocita-secrets init NAME                  create a new random secret
  velocita-secrets push NAME HOST REMOTE_PATH write NAME (+ .next/.previous) to HOST
  velocita-secrets reload HOST                SIGHUP the node on HOST
  velocita-secrets rotate-begin NAME          create NAME.next
  velocita-secrets rotate-promote NAME        NAME -> NAME.previous, NAME.next -> NAME
  velocita-secrets rotate-finish NAME         delete NAME.previous
  velocita-secrets client-key NAME            raw bytes for velocita-v2-client --key-stdin

Rotation (M2_SECRETS_ROTATION_REVIEW.md): after each rotate-* step, push and
reload every host that uses NAME, then run a harmless authenticated command
before the next step.
"""
import argparse
import secrets as random_source
import shlex
import subprocess
import sys

SERVICE = "velocita"
SECRET_BYTES = 32
SUFFIXES = ("", ".next", ".previous")


class ToolError(Exception):
    pass


class Keychain:
    """macOS Keychain through /usr/bin/security; values travel on stdin/stdout only."""

    def __init__(self, run=subprocess.run):
        self.run = run

    def read(self, account):
        result = self.run(["security", "find-generic-password", "-s", SERVICE, "-a", account, "-w"],
                          capture_output=True, text=True)
        if result.returncode != 0:
            return None
        value = result.stdout.strip()
        try:
            raw = bytes.fromhex(value)
        except ValueError:
            raise ToolError(f"keychain item {account} is not hex")
        if len(raw) != SECRET_BYTES:
            raise ToolError(f"keychain item {account} is not {SECRET_BYTES} bytes")
        return raw

    def write(self, account, raw):
        if len(raw) != SECRET_BYTES:
            raise ToolError("refusing to store a secret of the wrong size")
        # `security -i` reads its command from stdin, so the value is never in argv.
        command = f"add-generic-password -U -s {SERVICE} -a {shlex.quote(account)} -w {raw.hex()}\n"
        result = self.run(["security", "-i"], input=command, capture_output=True, text=True)
        if result.returncode != 0:
            raise ToolError(f"keychain write failed for {account}")

    def delete(self, account):
        result = self.run(["security", "delete-generic-password", "-s", SERVICE, "-a", account],
                          capture_output=True, text=True)
        if result.returncode != 0:
            raise ToolError(f"keychain delete failed for {account}")


# Runs on the host. Refuses anything but a private tmpfs directory owned by the
# SSH user, then replaces the file atomically. The secret arrives on stdin.
REMOTE_WRITE = """set -eu
target={target}
dir=$(dirname "$target")
[ "$(stat -f -c %T "$dir")" = tmpfs ] || {{ echo "refused: $dir is not tmpfs" >&2; exit 3; }}
[ "$(stat -c %a "$dir")" = 700 ] || {{ echo "refused: $dir is not mode 700" >&2; exit 3; }}
[ "$(stat -c %u "$dir")" = "$(id -u)" ] || {{ echo "refused: $dir is not owned by $(id -un)" >&2; exit 3; }}
umask 077
cat > "$target.tmp"
[ "$(wc -c < "$target.tmp")" -eq {size} ] || {{ rm -f "$target.tmp"; echo "refused: short write" >&2; exit 3; }}
mv -f "$target.tmp" "$target"
"""

REMOTE_REMOVE = """set -eu
rm -f {target}
"""


class Remote:
    def __init__(self, run=subprocess.run):
        self.run = run

    def write(self, host, path, raw):
        script = REMOTE_WRITE.format(target=shlex.quote(path), size=len(raw))
        result = self.run(["ssh", host, "sh", "-c", shlex.quote(script)], input=raw, capture_output=True)
        if result.returncode != 0:
            raise ToolError(f"push to {host}:{path} refused: {result.stderr.decode(errors='replace').strip()}")

    def remove(self, host, path):
        script = REMOTE_REMOVE.format(target=shlex.quote(path))
        result = self.run(["ssh", host, "sh", "-c", shlex.quote(script)], capture_output=True)
        if result.returncode != 0:
            raise ToolError(f"remove on {host}:{path} failed")

    def reload(self, host, command):
        result = self.run(["ssh", host, command], capture_output=True)
        if result.returncode != 0:
            raise ToolError(f"reload on {host} failed")


def init(keychain, name):
    if keychain.read(name) is not None:
        raise ToolError(f"{name} already exists; rotate it instead")
    keychain.write(name, random_source.token_bytes(SECRET_BYTES))


def push(keychain, remote, name, host, remote_path):
    current = keychain.read(name)
    if current is None:
        raise ToolError(f"{name} does not exist")
    for suffix in SUFFIXES:
        value = current if suffix == "" else keychain.read(name + suffix)
        if value is None:
            remote.remove(host, remote_path + suffix)   # keep the host in sync with the Keychain
        else:
            remote.write(host, remote_path + suffix, value)


def rotate_begin(keychain, name):
    if keychain.read(name) is None:
        raise ToolError(f"{name} does not exist")
    if keychain.read(name + ".next") is not None:
        raise ToolError(f"{name}.next already exists: a rotation is in progress")
    if keychain.read(name + ".previous") is not None:
        raise ToolError(f"{name}.previous still exists: finish the previous rotation first")
    keychain.write(name + ".next", random_source.token_bytes(SECRET_BYTES))


def rotate_promote(keychain, name):
    current, upcoming = keychain.read(name), keychain.read(name + ".next")
    if current is None or upcoming is None:
        raise ToolError(f"{name} has no rotation to promote")
    keychain.write(name + ".previous", current)
    keychain.write(name, upcoming)
    keychain.delete(name + ".next")


def rotate_finish(keychain, name):
    if keychain.read(name + ".next") is not None:
        raise ToolError(f"{name}.next exists: promote before finishing")
    if keychain.read(name + ".previous") is None:
        raise ToolError(f"{name} has no previous secret to retire")
    keychain.delete(name + ".previous")


def client_key(keychain, name, out):
    if out.isatty():
        raise ToolError("refusing to write raw secret bytes to a terminal; pipe into velocita-v2-client --key-stdin")
    current = keychain.read(name)
    if current is None:
        raise ToolError(f"{name} does not exist")
    extra = keychain.read(name + ".previous")
    out.buffer.write(current + (extra or b""))
    out.buffer.flush()


def main(argv=None, keychain=None, remote=None, out=sys.stdout):
    parser = argparse.ArgumentParser(prog="velocita-secrets")
    sub = parser.add_subparsers(dest="command", required=True)
    for command in ("init", "rotate-begin", "rotate-promote", "rotate-finish", "client-key"):
        sub.add_parser(command).add_argument("name")
    p = sub.add_parser("push")
    p.add_argument("name")
    p.add_argument("host")
    p.add_argument("remote_path")
    r = sub.add_parser("reload")
    r.add_argument("host")
    r.add_argument("--command", default="pkill -HUP -x velocita-v2-node")
    args = parser.parse_args(argv)
    keychain = keychain or Keychain()
    remote = remote or Remote()
    try:
        if args.command == "init":
            init(keychain, args.name)
        elif args.command == "push":
            push(keychain, remote, args.name, args.host, args.remote_path)
        elif args.command == "reload":
            remote.reload(args.host, args.command)
        elif args.command == "rotate-begin":
            rotate_begin(keychain, args.name)
        elif args.command == "rotate-promote":
            rotate_promote(keychain, args.name)
        elif args.command == "rotate-finish":
            rotate_finish(keychain, args.name)
        elif args.command == "client-key":
            client_key(keychain, args.name, out)
    except ToolError as error:
        print(f"velocita-secrets: {error}", file=sys.stderr)
        return 1
    if args.command != "client-key":
        print(f"velocita-secrets: {args.command} ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
