+ * @param[in] entry The next committed entry
+ * @param[in] entry_idx The index that would be applied
+ * @return 0 to apply; non-zero to stop application */
+typedef int (
+*func_before_apply_f
+)   (
+    raft_server_t* raft,
+    void *user_data,
+    raft_entry_t *entry,
+    raft_index_t entry_idx
+    );
+
