+/* Ask for pre-votes for current_term + 1. Our term, vote and log are untouched:
+ * an isolated node repeats this every timeout without ever raising its term. */
+static int raft_become_precandidate(raft_server_t* me_)
+{
+    raft_server_private_t* me = (raft_server_private_t*)me_;
+    int i;
+
+    __log(me_, NULL, "becoming pre-candidate");
+
+    raft_become_follower(me_);
+    /* We are giving up on the old leader; keeping it would make us refuse the
+     * pre-votes of every other node that has also given up on it. */
+    me->current_leader = NULL;
+    me->prevote_in_progress = 1;
+    for (i = 0; i < me->num_nodes; i++)
+        raft_node_vote_for_me(me->nodes[i], 0);
+
+    for (i = 0; i < me->num_nodes; i++)
+    {
+        raft_node_t* node = me->nodes[i];
+
+        if (me->node != node &&
+            raft_node_is_active(node) &&
+            raft_node_is_voting(node))
+        {
+            raft_send_requestvote(me_, node);
+        }
+    }
+    return 0;
+}
