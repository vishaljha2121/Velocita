@@ -938,0 +1015,16 @@ int raft_send_appendentries(raft_server_t* me_, raft_node_t* node)
+/* A peer behind the snapshot cannot be served until a snapshot is installed,
+ * but it must still hear from its leader: silent, it campaigns, and its higher
+ * terms depose a healthy leader again and again. An empty append at the
+ * snapshot point resets its election timer; its log check refuses it. Sent only
+ * from the periodic heartbeat so a refusal cannot trigger an immediate resend. */
+static int raft_send_snapshot_point_heartbeat(raft_server_t* me_, raft_node_t* node)
+{
+    raft_server_private_t* me = (raft_server_private_t*)me_;
+    msg_appendentries_t ae = {};
+    ae.term = me->current_term;
+    ae.leader_commit = raft_get_commit_idx(me_);
+    ae.prev_log_idx = me->snapshot_last_idx;
+    ae.prev_log_term = me->snapshot_last_term;
+    return me->cb.send_appendentries(me_, me->udata, node, &ae);
+}
