[Unit]
Description=Velocita verifiable tape metrics exporter
After=velocita-tape-voter.service

[Service]
Type=simple
ExecStart=/usr/bin/podman run --rm --replace --name velocita-tape-exporter \
    --network host --userns=keep-id --read-only --security-opt no-new-privileges --cap-drop all \
    --pids-limit 16 --memory 64m --log-driver journald \
    -v %h/velocita-tape/data:/var/lib/velocita-tape:ro \
    localhost/velocita-tape:current velocita-tape-exporter 0.0.0.0 45301 /var/lib/velocita-tape/voter/metrics.prom
ExecStop=/usr/bin/podman stop -t 5 velocita-tape-exporter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
