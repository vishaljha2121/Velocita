{
 "uid": "velocita-tape",
 "title": "Verifiable tape",
 "tags": [
  "velocita",
  "tape"
 ],
 "timezone": "utc",
 "editable": false,
 "graphTooltip": 1,
 "refresh": "10s",
 "schemaVersion": 39,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Now",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Books valid",
   "description": "Order books every voter currently holds as valid, out of 12. Lower means a book is waiting for its next snapshot.",
   "targets": [
    {
     "refId": "A",
     "expr": "min(sum by (host) (velocita_tape_book_state{state=\"valid\",source=\"log\"}))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     },
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#ec835a",
        "value": null
       },
       {
        "color": "#0ca30c",
        "value": 12
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "w": 4,
    "h": 4,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-tape-prometheus"
   }
  },
  {
   "type": "stat",
   "title": "Leader",
   "description": "The voter that orders the log right now.",
   "targets": [
    {
     "refId": "A",
     "expr": "max(velocita_tape_raft_leader_id)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     },
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "nuc1",
         "color": "#3987e5"
        },
        "2": {
         "text": "pi",
         "color": "#d95926"
        },
        "3": {
         "text": "nuc2",
         "color": "#199e70"
        },
        "-1": {
         "text": "electing",
         "color": "#fab219"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
