  {
   "id": 8,
   "type": "row",
   "title": "Agreement between the three vantage points",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 5
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Update verdicts per minute",
   "description": "Every published update gets one verdict: how many of the three recorders saw identical bytes before it closed.",
   "targets": [
    {
     "refId": "A",
     "expr": "max(rate(velocita_tape_verdicts_total{kind=\"update\",outcome=\"agree_3_of_3\"}[2m])) * 60",
     "legendFormat": "agree_3_of_3",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "max(rate(velocita_tape_verdicts_total{kind=\"update\",outcome=\"agree_2_of_3\"}[2m])) * 60",
     "legendFormat": "agree_2_of_3",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "max(rate(velocita_tape_verdicts_total{kind=\"update\",outcome=\"only_1_of_3\"}[2m])) * 60",
     "legendFormat": "only_1_of_3",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     }
    },
    {
     "refId": "D",
     "expr": "max(rate(velocita_tape_verdicts_total{kind=\"update\",outcome=\"divergent\"}[2m])) * 60",
     "legendFormat": "divergent",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     }
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 25,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      },
      "spanNulls": false,
      "axisSoftMin": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "agree_3_of_3"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#0ca30c"
        }
       },
       {
        "id": "displayName",
        "value": "3 of 3 agree"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "agree_2_of_3"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#fab219"
        }
       },
       {
        "id": "displayName",
        "value": "2 of 3 agree"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "only_1_of_3"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ec835a"
        }
       },
       {
        "id": "displayName",
        "value": "seen by 1 only"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "divergent"
