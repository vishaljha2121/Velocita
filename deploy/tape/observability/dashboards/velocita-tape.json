  {
   "type": "timeseries",
   "title": "Arrival skew between recorders",
   "description": "Time between the first and last recorder receiving the same update.",
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, max by (le) (rate(velocita_tape_vantage_skew_seconds_bucket[5m])))",
     "legendFormat": "median",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
