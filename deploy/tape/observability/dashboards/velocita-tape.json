  {
   "type": "bargauge",
   "title": "Longest silence between DEPTH messages",
   "description": "The longest gap ever seen between two DEPTH messages for each book. Long gaps are normal outside US market hours.",
   "targets": [
    {
     "refId": "A",
     "expr": "max by (symbol) (velocita_tape_book_max_silence_seconds)",
     "legendFormat": "{{symbol}}",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     },
     "instant": true,
     "range": false
    }
   ],
