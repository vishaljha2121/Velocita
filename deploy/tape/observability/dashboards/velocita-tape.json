  {
   "type": "state-timeline",
   "title": "Book state per symbol",
   "description": "Green while the reconstructed book is valid; red while it waits for a snapshot after a gap or divergence.",
   "targets": [
    {
     "refId": "A",
     "expr": "max by (symbol) (velocita_tape_book_state{state=\"valid\",source=\"log\"})",
     "legendFormat": "{{symbol}}",
     "datasource": {
      "type": "prometheus",
      "uid": "velocita-tape-prometheus"
     }
    }
   ],
   "options": {
    "showValue": "never",
    "rowHeight": 0.8,
    "mergeValues": true,
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "valid",
         "color": "#0ca30c"
        },
        "0": {
         "text": "not valid",
         "color": "#d03b3b"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#d03b3b",
        "value": null
       },
       {
        "color": "#0ca30c",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
