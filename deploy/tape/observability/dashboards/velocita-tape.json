    "w": 4,
    "h": 4,
    "x": 4,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-tape-prometheus"
   }
  },
  {
   "type": "stat",
   "title": "Raft term",
   "description": "Increases by one at every election. A steady value means a stable leader.",
