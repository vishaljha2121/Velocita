  {
   "type": "row",
   "title": "Journey: TrueMarkets tick -> model -> kernel decision -> executor -> TrueMarkets",
   "id": 12,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 24
