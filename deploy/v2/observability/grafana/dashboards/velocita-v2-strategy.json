    {
     "expr": "sum(60 * rate(velocita_shadow_directives_total{strategy=\"stochastic\",stage=\"proposed\",directive!=\"no_action\"}[5m])) or vector(0)",
     "legendFormat": "order requests",
     "refId": "D"
    },
    {
     "expr": "sum(60 * rate(velocita_indicator_paper_authorizations_total{strategy=\"stochastic\",code=\"applied\"}[5m])) or vector(0)",
     "legendFormat": "orders authorized",
     "refId": "E"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
