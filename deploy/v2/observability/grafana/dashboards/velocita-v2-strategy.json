  {
   "type": "stat",
   "title": "Position",
   "id": 18,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "daily = acts once per UTC day on the last decision before midnight (like the backtest; this one counts for promotion). tick = acts on every committed decision.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 42
   },
   "targets": [
    {
     "expr": "velocita_shadow_book_position{strategy=\"stochastic\"}",
     "legendFormat": "{{timing}}",
     "refId": "A",
     "instant": true
    }
