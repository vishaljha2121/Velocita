    "x": 8,
    "y": 13
   },
   "targets": [
    {
     "expr": "sum by (rule) (60 * rate(velocita_shadow_rule_matches_total{strategy=\"stochastic\"}[5m]))",
     "legendFormat": "rule {{rule}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
