    }
   }
  },
  {
   "type": "timeseries",
   "title": "Messages by outcome (per minute)",
   "id": 15,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "forwarded = sent to the cluster; quiet = nothing to act on, kept local (one bar in 30 s is still sent); stale = older than 2 s; throttled = a second bar in the same wall-clock second; duplicate = already handled; warming_up = indicators not ready; invalid = rejected frame or a bar ahead of the local clock (alert: VelocitaPaperBadMarketData).",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 30
   },
   "targets": [
    {
     "expr": "sum by (outcome) (60 * rate(velocita_shadow_messages_total{strategy=\"stochastic\"}[5m]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Signal and price",
   "id": 16,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 38
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Signal flags sent to the kernel",
   "id": 17,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "1 = the edge asked for an entry or an exit on the last forwarded bar. Sampled at the scrape interval, so a one-second flag can fall between samples; the ledger is exact.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 39
   },
   "targets": [
    {
     "expr": "max(velocita_shadow_feature_micros{strategy=\"stochastic\",name=\"entry_flag\"}) / 1e6",
     "legendFormat": "entry",
     "refId": "A"
    },
    {
     "expr": "max(velocita_shadow_feature_micros{strategy=\"stochastic\",name=\"exit_flag\"}) / 1e6",
     "legendFormat": "exit",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
