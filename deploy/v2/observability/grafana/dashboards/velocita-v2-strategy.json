  {
   "type": "timeseries",
   "title": "Tick to decision (ms)",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Active stochastic only: payload delivered to Python -> committed decision reply at the local C++ submitter. Includes indicator/journal work and two Raft commits; excludes HTTP fetch and order execution. Histogram interpolation over sparse windows is not a reliable tail-latency estimate. See Paper trading for sample counts and a gated p99.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(velocita_shadow_tick_to_decision_ms_bucket{strategy=\"stochastic\"}[5m])))",
     "legendFormat": "p50 (5m)",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(velocita_shadow_tick_to_decision_ms_bucket{strategy=\"stochastic\"}[5m])))",
     "legendFormat": "p99 (5m)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Where the time goes (average ms per tick, 5m)",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "edge = tick received -> submitter read; source_commit = source event committed; decision_commit = decision frame committed. Commit hops include the follower durable-ack delay.",
   "gridPos": {
    "h": 8,
