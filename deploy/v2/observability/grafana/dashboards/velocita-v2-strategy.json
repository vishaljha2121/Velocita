  {
   "type": "timeseries",
   "title": "Tick to decision (ms)",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Payload delivered to Python to the committed decision reply at the local C++ submitter. Includes indicator and journal work and two Raft commits; excludes authorization and fills. Bucket interpolation, not exact percentiles.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(velocita_shadow_tick_to_decision_ms_bucket{strategy=\"stochastic\"}[5m])))",
     "legendFormat": "p50 (5m)",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(velocita_shadow_tick_to_decision_ms_bucket{strategy=\"stochastic\"}[5m])))",
     "legendFormat": "p99 (5m)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Where the time goes (average ms per tick, 5m)",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "edge = tick received to submitter read; source_commit = source event committed; decision_commit = decision frame committed. Commit hops include the follower durable-ack delay.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "expr": "sum by (hop) (rate(velocita_shadow_hop_ms_sum{strategy=\"stochastic\"}[5m])) / scalar(clamp_min(sum(rate(velocita_shadow_tick_to_decision_ms_count{strategy=\"stochastic\"}[5m])), 1e-9))",
     "legendFormat": "{{hop}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Decisions by resolution (per minute)",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "0 = no action; 1 = an order was proposed, sized and bounded.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "expr": "sum by (resolution) (60 * rate(velocita_shadow_action_resolutions_total{strategy=\"stochastic\"}[5m]))",
     "legendFormat": "resolution {{resolution}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
