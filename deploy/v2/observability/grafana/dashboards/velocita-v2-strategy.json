    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Journey: public one-second bar -> edge -> kernel decision -> paper gateway",
   "id": 11,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 21
   },
   "panels": []
  },
  {
   "type": "bargauge",
   "title": "Bar-to-order funnel (selected time range)",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Counted from the edge's metrics over the dashboard's time range. Prometheus increase extrapolates, so small counts can show fractions. The kernel refuses the first request for every order and asks the edge to re-read its position, so 4 is about twice 5.",
   "gridPos": {
    "h": 8,
    "w": 16,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "expr": "sum(increase(velocita_shadow_messages_total{strategy=\"stochastic\"}[$__range]))",
     "legendFormat": "1  Market messages handled",
     "refId": "A",
     "instant": true
    },
    {
     "expr": "sum(increase(velocita_shadow_messages_total{strategy=\"stochastic\",outcome=\"forwarded\"}[$__range]))",
     "legendFormat": "2  Closed bars sent to the cluster",
     "refId": "B",
     "instant": true
    },
    {
     "expr": "sum(increase(velocita_shadow_decisions_total{strategy=\"stochastic\"}[$__range]))",
     "legendFormat": "3  Decisions committed by the kernel",
     "refId": "C",
     "instant": true
    },
    {
     "expr": "sum(increase(velocita_shadow_directives_total{strategy=\"stochastic\",stage=\"proposed\",directive!=\"no_action\"}[$__range])) or vector(0)",
     "legendFormat": "4  Order requests (each order is asked twice)",
     "refId": "D",
     "instant": true
    },
    {
     "expr": "sum(increase(velocita_indicator_paper_authorizations_total{strategy=\"stochastic\",code=\"applied\"}[$__range])) or vector(0)",
     "legendFormat": "5  Orders authorized by the kernel",
     "refId": "E",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "text",
   "id": 13,
   "title": "After authorization",
   "gridPos": {
    "x": 16,
    "y": 22,
    "w": 8,
    "h": 8
   },
   "options": {
    "mode": "markdown",
    "content": "Authorized orders go to the paper gateway, which fills them in a simulator. See *Paper trading* for orders, fills, position and fees. **Nothing reaches a venue.**"
   }
  },
  {
   "type": "timeseries",
   "title": "Journey per minute",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "The funnel over time (5 min rate).",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 30
   },
   "targets": [
    {
     "expr": "sum(60 * rate(velocita_shadow_messages_total{strategy=\"stochastic\"}[5m]))",
     "legendFormat": "market messages",
     "refId": "A"
    },
    {
     "expr": "sum(60 * rate(velocita_shadow_messages_total{strategy=\"stochastic\",outcome=\"forwarded\"}[5m]))",
     "legendFormat": "bars sent",
     "refId": "B"
    },
    {
     "expr": "sum(60 * rate(velocita_shadow_decisions_total{strategy=\"stochastic\"}[5m]))",
     "legendFormat": "decisions committed",
     "refId": "C"
