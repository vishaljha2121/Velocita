 "panels": [
  {
   "type": "row",
   "title": "Strategy edge: one-second bars to committed decisions",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Submitter ready",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "1 once the policy is installed and the strategy mode is normal.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "((max(velocita_indicator_run_state{strategy=\"stochastic\"}) == 1) * 0 + 2) or max(velocita_shadow_submitter_ready{strategy=\"stochastic\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NOT READY"
        },
        "1": {
         "text": "READY"
        },
        "2": {
         "text": "COMPLETED",
         "color": "blue"
        }
       }
      }
     ],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "stat",
   "title": "Last decision",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Seconds since the cluster last recorded a decision. The edge sends a bar when it has a signal or a stop, and otherwise one every 30 seconds.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "expr": "max(velocita_shadow_last_decision_age_seconds{strategy=\"stochastic\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 45
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "stat",
   "title": "Rule agreement",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Share of decisions where the cluster matched the rule the Python edge predicted. Must be 100%.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "expr": "sum(velocita_shadow_agreement_total{strategy=\"stochastic\",result=\"agree\"}) / clamp_min(sum(velocita_shadow_agreement_total{strategy=\"stochastic\"}), 1)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
