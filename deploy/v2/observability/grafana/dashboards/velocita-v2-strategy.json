     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Rule matched (per minute)",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "rule 0 = exit; rule 1 = enter; 65535 = no rule matched (hold).",
   "gridPos": {
    "h": 8,
