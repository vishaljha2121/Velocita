    }
   }
  },
  {
   "type": "timeseries",
   "title": "Market data age at decision (ms)",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Bar close to arrival at the edge. The edge drops a bar older than 2 s and the policy refuses one too.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 13
   },
   "targets": [
    {
     "expr": "max(velocita_shadow_market_data_age_ms{strategy=\"stochastic\"})",
     "legendFormat": "last tick",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
