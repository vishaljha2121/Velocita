{
 "uid": "velocita-v2-hosts",
 "title": "Velocita \u2014 Hosts",
 "description": "The NUCs and the Pi from node-exporter: CPU, memory, disks, temperature, network.",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "refresh": "10s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "tags": [
  "velocita",
  "v2",
  "hosts"
 ],
 "timezone": "browser",
 "links": [
