    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "stat",
   "title": "Since last fill",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Seconds since the last paper fill. The daily trend strategy trades a few times a year, so a long gap is normal.",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "expr": "time() - max(velocita_gateway_last_fill_timestamp_seconds)",
     "legendFormat": "",
