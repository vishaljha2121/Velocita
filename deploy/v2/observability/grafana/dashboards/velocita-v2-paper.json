 "panels": [
  {
   "type": "row",
   "title": "Right now: may the paper gateway take new risk?",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "New risk",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "1 = the gateway halted new risk after an unknown order outcome or a failed reconciliation. It sends no risk-increasing order until an operator has checked the gateway journal. Alert: VelocitaGatewayNewRiskStopped.",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "max(velocita_gateway_new_risk_stopped)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NEW RISK ALLOWED"
        },
        "1": {
         "text": "NEW RISK STOPPED"
        }
       }
      }
     ],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "stat",
   "title": "Gateway",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "1 while the gateway process runs. 'unknown' = not deployed, or its metrics are not scraped.",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "expr": "max(velocita_gateway_up)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN"
        },
        "1": {
         "text": "UP"
        }
       }
      }
     ],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "stat",
   "title": "Unknown outcomes (range)",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Orders whose venue outcome the gateway could not establish. Each one stops new risk. Must be 0.",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "expr": "sum(increase(velocita_gateway_unknown_outcomes_total[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
