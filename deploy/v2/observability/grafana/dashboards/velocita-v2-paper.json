  {
   "type": "row",
   "title": "Orders, fills, rejects and authority",
   "id": 13,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Orders sent (range)",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 25
   },
   "targets": [
    {
     "expr": "sum(increase(velocita_gateway_orders_sent_total[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
