  {
   "type": "row",
   "title": "Tick to trade: decision -> authorized -> proof -> sent -> fill -> committed",
   "id": 7,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Tick to trade, mean (range)",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Sum of the five stage means over the dashboard's time range: decision committed -> fill committed. A stage with no orders in the range adds 0; 'unknown' until every stage has seen at least one order.",
   "gridPos": {
    "h": 8,
    "w": 4,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "(sum(increase(velocita_gateway_stage_ms_sum{stage=\"decision_to_authorized\"}[$__range])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"decision_to_authorized\"}[$__range])), 1e-9)) + (sum(increase(velocita_gateway_stage_ms_sum{stage=\"authorized_to_proof\"}[$__range])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"authorized_to_proof\"}[$__range])), 1e-9)) + (sum(increase(velocita_gateway_stage_ms_sum{stage=\"proof_to_sent\"}[$__range])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"proof_to_sent\"}[$__range])), 1e-9)) + (sum(increase(velocita_gateway_stage_ms_sum{stage=\"sent_to_fill\"}[$__range])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"sent_to_fill\"}[$__range])), 1e-9)) + (sum(increase(velocita_gateway_stage_ms_sum{stage=\"fill_to_committed\"}[$__range])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"fill_to_committed\"}[$__range])), 1e-9))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "timeseries",
   "title": "Where the time goes (mean ms per order, 5m)",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Stacked per-stage means, in the order an order passes through them; the top of the stack is the mean tick-to-trade. sent_to_fill is the (simulated) venue.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 4,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum(increase(velocita_gateway_stage_ms_sum{stage=\"decision_to_authorized\"}[5m])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"decision_to_authorized\"}[5m])), 1e-9)",
     "legendFormat": "decision_to_authorized",
     "refId": "A"
    },
    {
     "expr": "sum(increase(velocita_gateway_stage_ms_sum{stage=\"authorized_to_proof\"}[5m])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"authorized_to_proof\"}[5m])), 1e-9)",
     "legendFormat": "authorized_to_proof",
     "refId": "B"
    },
    {
     "expr": "sum(increase(velocita_gateway_stage_ms_sum{stage=\"proof_to_sent\"}[5m])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"proof_to_sent\"}[5m])), 1e-9)",
     "legendFormat": "proof_to_sent",
     "refId": "C"
    },
    {
     "expr": "sum(increase(velocita_gateway_stage_ms_sum{stage=\"sent_to_fill\"}[5m])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"sent_to_fill\"}[5m])), 1e-9)",
     "legendFormat": "sent_to_fill",
     "refId": "D"
    },
    {
     "expr": "sum(increase(velocita_gateway_stage_ms_sum{stage=\"fill_to_committed\"}[5m])) / clamp_min(sum(increase(velocita_gateway_stage_ms_count{stage=\"fill_to_committed\"}[5m])), 1e-9)",
     "legendFormat": "fill_to_committed",
     "refId": "E"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "bargauge",
   "title": "p99 by stage (selected time range)",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "99th percentile of each stage over the dashboard's time range, from the stage histogram. Percentiles do not add: this is not a p99 of the whole path.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le) (increase(velocita_gateway_stage_ms_bucket{stage=\"decision_to_authorized\"}[$__range])))",
     "legendFormat": "decision_to_authorized",
     "refId": "A",
     "instant": true
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (increase(velocita_gateway_stage_ms_bucket{stage=\"authorized_to_proof\"}[$__range])))",
     "legendFormat": "authorized_to_proof",
     "refId": "B",
     "instant": true
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (increase(velocita_gateway_stage_ms_bucket{stage=\"proof_to_sent\"}[$__range])))",
     "legendFormat": "proof_to_sent",
     "refId": "C",
     "instant": true
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (increase(velocita_gateway_stage_ms_bucket{stage=\"sent_to_fill\"}[$__range])))",
     "legendFormat": "sent_to_fill",
     "refId": "D",
     "instant": true
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (increase(velocita_gateway_stage_ms_bucket{stage=\"fill_to_committed\"}[$__range])))",
     "legendFormat": "fill_to_committed",
     "refId": "E",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "decimals": 1,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "color",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Stage latency p50 (5m)",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Median per stage. Resolution is limited by the histogram's buckets.",
   "gridPos": {
