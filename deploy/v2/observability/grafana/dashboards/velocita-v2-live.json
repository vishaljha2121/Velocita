    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "velocita_live_observer_up and (time() - velocita_live_observer_observed_seconds < 45)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
