      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
