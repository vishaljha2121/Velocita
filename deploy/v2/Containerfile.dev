ARG BASE=docker.io/library/ubuntu@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78
FROM ${BASE}
ARG BASE

ARG DEBIAN_FRONTEND=noninteractive
ARG AERON_COMMIT=5b62f21d917af027cdf5a3241aa5f355149b04fa
ARG RAFT_COMMIT=e428eeb921a014192d1d703dd317f3f29f5916c5

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates ccache cmake g++ git libbsd-dev ninja-build patch pkg-config python3 uuid-dev \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/velocita-deps/aeron /opt/velocita-deps/willemt-raft \
    && git -C /opt/velocita-deps/aeron init -q \
    && git -C /opt/velocita-deps/aeron remote add origin https://github.com/aeron-io/aeron.git \
    && git -C /opt/velocita-deps/aeron fetch -q --depth 1 origin "${AERON_COMMIT}" \
    && git -C /opt/velocita-deps/aeron checkout -q --detach FETCH_HEAD \
    && git -C /opt/velocita-deps/willemt-raft init -q \
    && git -C /opt/velocita-deps/willemt-raft remote add origin https://github.com/willemt/raft.git \
    && git -C /opt/velocita-deps/willemt-raft fetch -q --depth 1 origin "${RAFT_COMMIT}" \
    && git -C /opt/velocita-deps/willemt-raft checkout -q --detach FETCH_HEAD \
    && test "$(git -C /opt/velocita-deps/aeron rev-parse HEAD)" = "${AERON_COMMIT}" \
    && test "$(git -C /opt/velocita-deps/willemt-raft rev-parse HEAD)" = "${RAFT_COMMIT}" \
    && test -z "$(git -C /opt/velocita-deps/willemt-raft status --porcelain)"

RUN mkdir -p /opt/velocita-dev \
    && { echo "base=${BASE}"; \
         echo "arch=$(dpkg --print-architecture)"; \
         echo "aeron_commit=$(git -C /opt/velocita-deps/aeron rev-parse HEAD)"; \
         echo "raft_commit=$(git -C /opt/velocita-deps/willemt-raft rev-parse HEAD)"; \
         echo "gxx=$(g++ --version | head -1)"; \
         echo "cmake=$(cmake --version | head -1)"; \
         echo "ninja=$(ninja --version)"; \
         echo "ccache=$(ccache --version | head -1)"; \
         echo "python3=$(python3 --version)"; \
         echo "--- packages"; \
         dpkg-query -W -f='${Package}=${Version}\n' | sort; \
       } > /opt/velocita-dev/MANIFEST \
    && head -9 /opt/velocita-dev/MANIFEST

LABEL org.velocita.role="toolchain" \
      org.velocita.aeron_commit="${AERON_COMMIT}" \
      org.velocita.raft_commit="${RAFT_COMMIT}"
