ARG BASE
FROM ${BASE}
ARG BASE
ARG SOURCE_COMMIT
ARG BUILD_CPU

RUN set -eu; \
    case "$BUILD_CPU" in ''|*[!0-9]*) exit 64;; esac; \
    taskset -pc "$BUILD_CPU" $$; \
    python3 -c 'import json,os,sys; from pathlib import Path; expected=int(sys.argv[1]); assert os.sched_getaffinity(0)=={expected}, "CPU affinity not enforced"; root=Path("/sys/fs/cgroup"); rel=next(line.split(":",2)[2] for line in Path("/proc/self/cgroup").read_text().splitlines() if line.startswith("0::")); node=root/rel.lstrip("/"); candidates=[root,node,*node.parents]; caps=[(str(p/"memory.max"),(p/"memory.max").read_text().strip()) for p in candidates if p.is_relative_to(root) and (p/"memory.max").is_file()]; assert any(v.isdecimal() and 0<int(v)<=1073741824 for _,v in caps), "1GiB memory bound not verified"; print(json.dumps({"cpu":expected,"memory_caps":caps}),flush=True)' "$BUILD_CPU"; \
    test "$(dpkg --print-architecture)" = amd64 && expected=2a79f82cce5de80ab5afc832af64acba549c963e89df509acfaeb5565cb232ee || { test "$(dpkg --print-architecture)" = arm64; expected=7796e188c717e65a9d4793a3b8673dde0124b3514a82b5ff3a060fe68728e97b; }; \
    test "$BASE" = "sha256:$expected"; \
    test "${#SOURCE_COMMIT}" = 40; \
    case "$SOURCE_COMMIT" in *[!0-9a-f]*) exit 64;; esac; \
    . /etc/os-release; \
    test "$ID" = ubuntu; test "$VERSION_ID" = 26.04; test "$VERSION_CODENAME" = resolute; \
    test "$(dpkg-query -W -f='${Version}' libcurl4t64)" = 8.18.0-1ubuntu2.7; \
    mkdir -p /opt/velocita-readiness-tls/empty /opt/velocita-readiness-tls/archives/partial /opt/velocita-readiness-tls/lists/partial; \
    cp /opt/velocita-dev/MANIFEST /opt/velocita-readiness-tls/parent-manifest.txt; \
    dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort > /opt/velocita-readiness-tls/packages-before.tsv; \
    printf '%s\n' "$BASE" > /opt/velocita-readiness-tls/parent-image.txt; \
    printf '%s\n' "$SOURCE_COMMIT" > /opt/velocita-readiness-tls/source-commit.txt; \
    if test "$(dpkg --print-architecture)" = amd64; then archive=https://archive.ubuntu.com/ubuntu; security=https://security.ubuntu.com/ubuntu; else archive=https://ports.ubuntu.com/ubuntu-ports; security=$archive; fi; \
    printf 'deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] %s resolute main\ndeb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] %s resolute-updates main\ndeb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] %s resolute-security main\n' "$archive" "$archive" "$security" > /opt/velocita-readiness-tls/sources.list; \
    printf '%s\n' \
      'Dir::Etc::Parts "/opt/velocita-readiness-tls/empty";' \
      'Dir::Etc::main "/dev/null";' \
      'Dir::Etc::sourcelist "/opt/velocita-readiness-tls/sources.list";' \
      'Dir::Etc::sourceparts "/opt/velocita-readiness-tls/empty";' \
      'Dir::Etc::netrc "/dev/null";' \
      'Dir::Etc::netrcparts "/opt/velocita-readiness-tls/empty";' \
      'Dir::Etc::preferences "/dev/null";' \
      'Dir::Etc::preferencesparts "/opt/velocita-readiness-tls/empty";' \
      'Dir::State::lists "/opt/velocita-readiness-tls/lists";' \
      'Dir::Cache::archives "/opt/velocita-readiness-tls/archives";' \
      'Acquire::http::Proxy "DIRECT";' \
      'Acquire::https::Proxy "DIRECT";' \
      'Acquire::http::AllowRedirect "false";' \
      'Acquire::https::AllowRedirect "false";' \
      'Acquire::https::Verify-Peer "true";' \
      'Acquire::https::Verify-Host "true";' \
      'Acquire::Retries "0";' \
      'Acquire::http::Timeout "30";' \
      'Acquire::https::Timeout "30";' \
      'APT::Update::Error-Mode "any";' \
      > /opt/velocita-readiness-tls/apt.conf

RUN set -eu; \
    case "$BUILD_CPU" in ''|*[!0-9]*) exit 64;; esac; \
    taskset -pc "$BUILD_CPU" $$; \
    python3 -c 'import json,os,sys; from pathlib import Path; expected=int(sys.argv[1]); assert os.sched_getaffinity(0)=={expected}, "CPU affinity not enforced"; root=Path("/sys/fs/cgroup"); rel=next(line.split(":",2)[2] for line in Path("/proc/self/cgroup").read_text().splitlines() if line.startswith("0::")); node=root/rel.lstrip("/"); candidates=[root,node,*node.parents]; caps=[(str(p/"memory.max"),(p/"memory.max").read_text().strip()) for p in candidates if p.is_relative_to(root) and (p/"memory.max").is_file()]; assert any(v.isdecimal() and 0<int(v)<=1073741824 for _,v in caps), "1GiB memory bound not verified"; print(json.dumps({"cpu":expected,"memory_caps":caps}),flush=True)' "$BUILD_CPU"; \
    export APT_CONFIG=/opt/velocita-readiness-tls/apt.conf; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-config dump > /opt/velocita-readiness-tls/apt-effective.conf; \
    apt-get update; \
    apt-get install --download-only -y --no-install-recommends --no-remove --no-upgrade libcurl4-openssl-dev=8.18.0-1ubuntu2.7; \
    sha256sum /opt/velocita-readiness-tls/archives/*.deb > /opt/velocita-readiness-tls/downloaded-packages.sha256; \
    apt-get install --no-download -y --no-install-recommends --no-remove --no-upgrade libcurl4-openssl-dev=8.18.0-1ubuntu2.7; \
    test "$(dpkg-query -W -f='${Version}' libcurl4-openssl-dev)" = 8.18.0-1ubuntu2.7; \
    test "$(pkg-config --modversion libcurl)" = 8.18.0; \
    dpkg-query -W -f='${binary:Package}\t${Version}\n' | sort > /opt/velocita-readiness-tls/packages-after.tsv; \
    python3 -c 'from pathlib import Path; p=Path("/opt/velocita-readiness-tls"); before=dict(line.split("\t") for line in (p/"packages-before.tsv").read_text().splitlines()); after=dict(line.split("\t") for line in (p/"packages-after.tsv").read_text().splitlines()); changed=[k for k,v in before.items() if after.get(k)!=v]; assert not changed, "existing parent packages changed: "+repr(changed); (p/"packages-added.tsv").write_text("".join(k+"\t"+after[k]+"\n" for k in sorted(after.keys()-before.keys())))'; \
    python3 -c 'import hashlib,json,re,subprocess; from pathlib import Path; p=Path("/opt/velocita-readiness-tls"); commands={"compiler":["c++","--version"],"cmake_package":["dpkg-query","-W","-f=${Version}","cmake"],"python":["python3","--version"],"openssl":["openssl","version","-a"],"curl":["curl-config","--version"],"curl_features":["curl-config","--features"],"curl_configure":["curl-config","--configure"],"curl_flags":["pkg-config","--cflags","--libs","libcurl"]}; result={k:subprocess.check_output(v,text=True).strip() for k,v in commands.items()}; libdir=subprocess.check_output(["pkg-config","--variable=libdir","libcurl"],text=True).strip(); incdir=subprocess.check_output(["pkg-config","--variable=includedir","libcurl"],text=True).strip(); library=(Path(libdir)/"libcurl.so").resolve(strict=True); listing=subprocess.check_output(["ldd",str(library)],text=True); assert "not found" not in listing; files={library,*[Path(s).resolve(strict=True) for s in re.findall(r"(?:=>\s+|^\s*)(/[^\s]+)",listing,re.MULTILINE)],*(Path(incdir)/"curl").glob("*.h")}; result["curl_ldd"]=listing; result["files_sha256"]={str(f):hashlib.sha256(f.read_bytes()).hexdigest() for f in sorted(files)}; (p/"dependency-manifest.json").write_text(json.dumps(result,indent=2,sort_keys=True)+"\n")'; \
    find /opt/velocita-readiness-tls/lists -type f -exec sha256sum '{}' + > /opt/velocita-readiness-tls/archive-metadata.sha256

LABEL org.velocita.role="readiness-tls-candidate" \
      org.velocita.production-qualified="false" \
      org.velocita.parent-image="${BASE}" \
      org.velocita.source-commit="${SOURCE_COMMIT}" \
      org.velocita.libcurl-dev-version="8.18.0-1ubuntu2.7"
