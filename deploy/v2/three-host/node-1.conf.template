# Three-host shadow: voter 1 on nuc1; voter 2 on the Pi, voter 3 on nuc2.
# Non-trading. Paths are as seen INSIDE the container (velocita-v2-node@.service).
# Commits need two durable copies of three, so any one voter may be lost.
#
# Fill placeholders with sed (never hand-copy secrets):
#   @INCARNATION@  32 hex digits, a NEW value, identical in all three voter configs
#   @CATALOG_ROOT@ printed by velocita-v2-shadow-catalog
#
# The node never compacts its log, so a returning voter always catches up from
# retained entries. Enabling compaction needs the online snapshot installer
# first (three-voter release; tests/v2_snapshot_catchup_red.cpp).
node_id = 1
data_root = /var/lib/velocita-v2/node-1
# First start only; switch to "recover" after the first successful start.
startup = bootstrap
cluster.incarnation = @INCARNATION@
catalog.root = @CATALOG_ROOT@
catalog.file = /etc/velocita/catalog.bin
deployment_mode = laboratory

# Voter links over Tailscale (WireGuard-encrypted), one secret per pair.
voter.1.endpoint = 100.72.127.102:42201
voter.2.endpoint = 100.84.151.116:42202
voter.2.key_file = /run/velocita-secrets/link-1-2.key
voter.3.endpoint = 100.85.36.22:42203
voter.3.key_file = /run/velocita-secrets/link-1-3.key

# The Mac reaches this voter over Tailscale.
ingress.endpoint = 100.72.127.102:42301

# Operator caller 9 = CallerId 7; responses to the Mac's Tailscale address.
caller.9.caller_id = 7
caller.9.key_file = /run/velocita-secrets/caller-9.key
caller.9.response_endpoint = 100.91.80.64:42400

# Soak bot (caller key 10 = CallerId 8): results go to nuc1, not the Mac.
caller.10.caller_id = 8
caller.10.key_file = /run/velocita-secrets/caller-10.key
caller.10.response_endpoint = 100.72.127.102:42410

# Shadow setup (caller key 11 = CallerId 9, operator band) on nuc1: the
# operator's one-shot program install and strategy-mode change. Its own key,
# replay fence and response port, so it never collides with the operator or soak bot.
caller.11.caller_id = 9
caller.11.key_file = /run/velocita-secrets/caller-11.key
caller.11.response_endpoint = 100.72.127.102:42411

# Strategy tick loop (caller key 12 = CallerId 21) on nuc1: proposes and, in
# paper mode, asks for authorization. Outside the operator band: it can never
# change controls.
caller.12.caller_id = 21
caller.12.key_file = /run/velocita-secrets/caller-12.key
caller.12.response_endpoint = 100.72.127.102:42412

# Paper gateway (caller key 13 = CallerId 22) on nuc1: claims authorized effects
# and reports simulated fills. Outside the operator band.
caller.13.caller_id = 22
caller.13.key_file = /run/velocita-secrets/caller-13.key
caller.13.response_endpoint = 100.72.127.102:42413
gateway.caller = 22

history.max_wal_bytes = 1073741824
