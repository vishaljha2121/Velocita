# Publishes which secrets this voter needs and whether each is present in the
# RAM-only secrets directory (deploy/v2/secrets-presence.sh). Names only: it
# never opens a secret and needs none, so it works right after a reboot, when
# the directory is empty and the alert VelocitaSecretsMissing says what to push.
# Every voter host, as `velocitas`; run by velocita-v2-secrets-check.timer.
[Unit]
Description=Velocita secrets presence check (names only, never reads a secret)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/velocita/host.env
ExecStartPre=/usr/bin/mkdir -p %h/velocita-v2/textfile
ExecStart=/bin/bash %h/src/aeron-raft-pi/deploy/v2/secrets-presence.sh \
    %h/velocita-v2/config/node-${VELOCITA_NODE}.conf %t/velocita-secrets \
    %h/velocita-v2/textfile/velocita-secrets.prom
