[Unit]
Description=Velocita secrets presence check (names only, never reads a secret)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/velocita/host.env
ExecStartPre=/usr/bin/mkdir -p %h/velocita-v2/textfile
ExecStart=/bin/bash %h/src/aeron-raft-pi/deploy/v2/secrets-presence.sh \
    %h/velocita-v2/config/node-${VELOCITA_NODE}.conf %t/velocita-secrets \
    %h/velocita-v2/textfile/velocita-secrets.prom
