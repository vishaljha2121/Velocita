# Copy to ~/.config/velocita/host.env on each machine and edit. Not secret.
# nuc1: VELOCITA_HOST=nuc1 VELOCITA_NODE=1  VELOCITA_TAILSCALE_IP=100.72.127.102 VELOCITA_SSH_HOST=nuc1
# Pi:   VELOCITA_HOST=pi   VELOCITA_NODE=2  VELOCITA_TAILSCALE_IP=100.84.151.116 VELOCITA_SSH_HOST=vishalkapi
# nuc2: VELOCITA_HOST=nuc2 VELOCITA_NODE=3  VELOCITA_TAILSCALE_IP=100.85.36.22   VELOCITA_SSH_HOST=nuc2
# VELOCITA_SSH_HOST is how the Mac reaches this host (used in the push command
# the VelocitaSecretsMissing alert prints).
VELOCITA_HOST=nuc1
VELOCITA_NODE=1
VELOCITA_TAILSCALE_IP=100.72.127.102
VELOCITA_SSH_HOST=nuc1
# nuc1 only: the URL the iPhone's ntfy app subscribes to. It must match exactly
# (docs/ALERT_DELIVERY_RUNBOOK.md); change it only together with the app.
VELOCITA_NTFY_BASE_URL=http://100.72.127.102:2586
