[Unit]
Description=Velocita V2 strategy edge (shadow or paper; never a venue)
After=network-online.target velocita-v2-node@1.service
AssertPathExists=%t/velocita-secrets/caller-12.key
AssertPathExists=%h/velocita-v2/shadow/shadow.env

[Service]
EnvironmentFile=%h/velocita-v2/shadow/shadow.env
ExecStartPre=/usr/bin/mkdir -p %h/velocita-v2/shadow/state %h/velocita-v2/textfile
ExecStart=/usr/bin/podman run --rm --replace --name velocita-v2-shadow-edge \
    --network host --userns=keep-id \
    --read-only --security-opt no-new-privileges --cap-drop all \
    --pids-limit 64 --memory 512m --log-driver journald \
    --shm-size 256m -e AERON_TERM_BUFFER_LENGTH=1048576 \
    -v %h/velocita-v2/config/catalog.bin:/etc/velocita/catalog.bin:ro \
    -v %h/velocita-v2/shadow/state:/state \
    -v %h/velocita-v2/textfile:/textfile \
    -v %t/velocita-secrets/caller-12.key:/run/velocita-secrets/caller-12.key:ro \
    localhost/velocita-v2-shadow:m3 \
    --usd-per-tick 1 --catalog-root ${VELOCITA_CATALOG_ROOT} --catalog-row 1,20,1,1,1 --min-tick-interval-s 30 \
    --order-quantity-lots 25 --max-notional-micros 25000000 --time-in-force fok --post-only prohibited \
    --program-out /state/trend.program --textfile /textfile/velocita-shadow.prom --history-cache /state/history \
    --ledger-db /state/ledger.db --costs-evidence /opt/velocita-model/evidence/quotes_buy_sell_1631utc.json \
    $VELOCITA_STRATEGY_ARGS \
    -- velocita-v2-shadow-submitter --program /state/trend.program --catalog /etc/velocita/catalog.bin \
    --caller-key-id 12 --caller-id 21 --key-file /run/velocita-secrets/caller-12.key \
    --incarnation ${VELOCITA_INCARNATION} \
    --session-file /state/strategy.session --state-file /state/strategy.state \
    --response-endpoint 100.72.127.102:42412 \
    $VELOCITA_NODES $VELOCITA_MODE_ARGS \
    --aeron-dir /dev/shm/velocita-shadow-aeron
ExecStop=/usr/bin/podman stop -t 15 velocita-v2-shadow-edge
RestartPreventExitStatus=64
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
