[Unit]
Description=Velocita V2 Grafana
After=velocita-v2-prometheus.service

[Service]
EnvironmentFile=%h/.config/velocita/host.env
ExecStart=/usr/bin/podman run --rm --replace --name velocita-v2-grafana \
    --network host --memory 512m \
    -v velocita-v2-grafana-data:/var/lib/grafana \
    -v %h/src/aeron-raft-pi/deploy/v2/observability/grafana/provisioning:/etc/grafana/provisioning:ro \
    -v %h/src/aeron-raft-pi/deploy/v2/observability/grafana/dashboards:/etc/grafana/dashboards:ro \
    -e GF_SERVER_HTTP_ADDR=${VELOCITA_TAILSCALE_IP} -e GF_SERVER_HTTP_PORT=3000 \
    -e GF_USERS_ALLOW_SIGN_UP=false -e GF_AUTH_ANONYMOUS_ENABLED=false \
    -e GF_ANALYTICS_REPORTING_ENABLED=false -e GF_ANALYTICS_CHECK_FOR_UPDATES=false \
    -e GF_SECURITY_DISABLE_GRAVATAR=true -e GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/dashboards/velocita-v2-cluster.json \
    docker.io/grafana/grafana:13.1.3
ExecStop=/usr/bin/podman stop -t 10 velocita-v2-grafana
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
