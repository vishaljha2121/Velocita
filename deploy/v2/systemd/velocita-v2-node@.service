[Unit]
Description=Velocita V2 voter %i
After=network-online.target
AssertPathExists=%t/velocita-secrets

[Service]
Type=simple
ExecStartPre=/bin/sh %h/src/aeron-raft-pi/deploy/v2/one-cluster-guard.sh velocita-v2-node-%i
ExecStart=/usr/bin/podman run --rm --replace --name velocita-v2-node-%i \
    --network host --userns=keep-id \
    --read-only --security-opt no-new-privileges --cap-drop all \
    --pids-limit 128 --memory 1g --log-driver journald \
    --shm-size 256m -e AERON_TERM_BUFFER_LENGTH=1048576 \
    -v %h/velocita-v2/config:/etc/velocita:ro \
    -v %h/velocita-v2/data:/var/lib/velocita-v2 \
    -v %t/velocita-secrets:/run/velocita-secrets:ro \
    localhost/velocita-v2:m3 --config /etc/velocita/node-%i.conf --aeron-dir /dev/shm/velocita-aeron
ExecStop=/usr/bin/podman stop -t 15 velocita-v2-node-%i
RestartPreventExitStatus=64
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
