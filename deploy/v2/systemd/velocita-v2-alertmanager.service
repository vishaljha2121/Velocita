# nuc1 only. Alertmanager on 127.0.0.1:9093: Prometheus sends it firing alerts;
# it groups them and posts to ntfy. The ntfy publish token is a file on disk
# (not in tmpfs with the cluster keys) so alerts still work after a reboot; it
# can publish to one topic on a tailnet-only server and nothing else.
[Unit]
Description=Velocita V2 Alertmanager
After=velocita-ntfy.service

[Service]
# Run as the container's root (this user, under rootless podman) so the 0600
# token file is readable; every capability is dropped.
ExecStart=/usr/bin/podman run --rm --replace --name velocita-v2-alertmanager \
    --network host --memory 128m --read-only --cap-drop all --security-opt no-new-privileges --user 0:0 \
    -v velocita-v2-alertmanager-data:/alertmanager \
    -v %h/src/aeron-raft-pi/deploy/v2/alerting/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro \
    -v %h/.config/velocita/ntfy-publish-token:/etc/alertmanager/ntfy-token:ro \
    docker.io/prom/alertmanager:v0.34.1 \
    --config.file=/etc/alertmanager/alertmanager.yml --storage.path=/alertmanager \
    --web.listen-address=127.0.0.1:9093 --cluster.listen-address=
ExecStop=/usr/bin/podman stop -t 10 velocita-v2-alertmanager
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
