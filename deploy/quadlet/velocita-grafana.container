[Unit]
Description=Velocita local Grafana
PartOf=velocita-observability.target
After=velocita-prometheus.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Container]
Image=docker.io/grafana/grafana:13.1.3
Pull=never
ContainerName=velocita-grafana
Network=host
Volume=velocita-grafana-data.volume:/var/lib/grafana:U
Volume=%h/.config/velocita/observability/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=%h/.config/velocita/observability/grafana/dashboards:/etc/grafana/dashboards:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PidsLimit=128
Memory=512m
LogDriver=journald
StopSignal=SIGTERM
StopTimeout=30
Environment=GF_SERVER_HTTP_ADDR=127.0.0.1
Environment=GF_SERVER_HTTP_PORT=3000
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_SECURITY_DISABLE_GRAVATAR=true
Environment=GF_LOG_MODE=console

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=40
LogRateLimitIntervalSec=30
LogRateLimitBurst=100

[Install]
WantedBy=velocita-observability.target
