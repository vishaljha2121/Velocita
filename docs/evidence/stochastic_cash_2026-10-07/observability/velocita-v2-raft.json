    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "expr": "velocita_v2_log_index{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",kind=\"current\"}",
     "legendFormat": "appended node {{node}}",
     "refId": "A"
    },
    {
     "expr": "velocita_v2_log_index{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",kind=\"durable\"}",
     "legendFormat": "on disk node {{node}}",
     "refId": "B"
    },
    {
     "expr": "velocita_v2_log_index{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",kind=\"commit\"}",
