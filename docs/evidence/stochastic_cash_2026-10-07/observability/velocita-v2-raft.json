   }
  },
  {
   "type": "timeseries",
   "title": "Commit, compaction floor and snapshot",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Healthy: the floor follows the commit closely and the snapshot steps up behind it. A flat floor while commits continue means some voter is not acknowledging, and nothing can be reclaimed.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "expr": "velocita_v2_log_index{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",kind=\"commit\"}",
     "legendFormat": "{{host}} commit",
     "refId": "A"
    },
    {
     "expr": "velocita_v2_compaction_floor{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\"}",
     "legendFormat": "{{host}} floor (every voter holds up to here)",
     "refId": "B"
    },
    {
     "expr": "velocita_v2_snapshot_index{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\"}",
     "legendFormat": "{{host}} snapshot (compacted up to here)",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "stat",
