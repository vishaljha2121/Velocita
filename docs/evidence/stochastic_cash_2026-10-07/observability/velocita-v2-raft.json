 "panels": [
  {
   "type": "row",
   "title": "Raft log & compaction",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Log used (ordinary)",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Retained Raft log entries of 8,128. Compaction reclaims only what every voter holds, so this climbs only while a voter is not keeping up. At 100% every normal command is refused.",
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "100 * velocita_v2_retained_log_entries{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",pool=\"ordinary\"} / velocita_v2_retained_log_capacity{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",pool=\"ordinary\"}",
     "legendFormat": "{{host}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 100
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "stat",
   "title": "Time until full",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Remaining ordinary entries at the last 30 minutes' fill rate.",
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "expr": "(velocita_v2_retained_log_capacity{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",pool=\"ordinary\"} - velocita_v2_retained_log_entries{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",pool=\"ordinary\"}) / clamp_min(deriv(velocita_v2_retained_log_entries{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",pool=\"ordinary\"}[30m]), 1e-9)",
     "legendFormat": "{{host}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 21600
       },
       {
        "color": "green",
        "value": 86400
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "wideLayout": true
   }
  },
  {
   "type": "stat",
   "title": "Kill reserve used",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "velocita-v2-prometheus"
   },
   "description": "Of 64 entries kept for operator kill-path commands (kill epoch, executor generation, strategy mode, mass cancel). Returned only when compaction reclaims those entries; each submitter start uses one.",
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "expr": "velocita_v2_retained_log_entries{strategy=\"stochastic\",paper_run=\"c8a6a0a78fbf49a099b222124a5d557f-cash-v1\",pool=\"protected\"}",
     "legendFormat": "{{host}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 32
       },
       {
        "color": "red",
        "value": 56
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
